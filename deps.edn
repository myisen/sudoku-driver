{:paths
 ["src" "resources"]

 ;; Dameng JDBC driver, pulled straight from Maven Central.
 ;;
 ;; Alternatively, use a user-provided local jar instead (put DmJdbcDriver18.jar in the lib/ directory):
 ;;   {com.dameng/DmJdbcDriver18 {:local/root "lib/DmJdbcDriver18.jar"}}
 :deps
 {com.dameng/DmJdbcDriver18 {:mvn/version "8.1.3.140"}}

 ;; the stuff below is only for hacking on the driver locally and is not needed if you follow the instructions in the
 ;; README and create a `:local/root` dep for the driver and launch the REPL from the Metabase project rather than
 ;; from here

 :aliases
 {:dev
  {:extra-deps
   {io.github.metabase/metabase {:git/tag "v0.46.0-RC2", :git/sha "32977a42"}}}}}
